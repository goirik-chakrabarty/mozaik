Bootstrap: docker
From: ubuntu:22.04

%help
    Apptainer definition file for Mozaik — REFERENCE-MATCHING (-O3) + neo + quantities PERF PATCH build.
    Derived from mozaik-opt-neo14_2026-07_neopatch.def, adding the quantities registry-memo patch
    (%post step 8c) on top of the neo _contains O(1) patch. Faithful test3 nt12: golden (neo12) 1015s
    -> neo14 refmatch ~1900s (regression) -> +neo _contains patch 913s -> +quantities memo 741s
    (27% BELOW golden), 30/30 reference tests green. Build to mozaik-opt-qpatch_2026-07-14.sif.
    Derived from mozaik-opt-neo14_2026-07.def with THREE differences:
      * NEST 3.4 and nest-step-current-module are compiled with -Dwith-optimize='-O3'
        (NO -march=native -mtune=native), matching the canonical upstream CSNG-MFF recipe
        (.github/workflows/mozaik-setup.yml) and the toolchain that produced tests/full_model
        reference_data.
      * neo 0.14.4's neo/core/objectlist.py + spiketrainlist.py are replaced with a patched
        _contains (O(1) cached id-set instead of an O(N) rebuild per append). This fixes the
        O(N^2) cross-rank Segment merge (pyNN gather_blocks -> neo container.merge) that ~halved
        P1 get_data throughput on neo 0.14 (test3 blank ~158s -> ~76s = golden). Correctness
        preserved (30/30 reference tests pass; dup-detection intact). Patched files copied from the
        build context (/app) in %post. See mozaik/slurm_neo14_pytest/26-07-13_neo14_slowdown_ROOTCAUSE.md.
    WHY: the production mozaik-opt-neo14_2026-07.def builds NEST with -march=native, which on
    sapphirerapids enables FMA / CPU-specific FP contraction. That perturbs NEST's GSL ODE
    integration at the ULP level (<=1e-9 mV for the AdEx EIF_cond_exp_isfa_ista; ~1e-14 for the
    linear IF_cond_exp), causing tests/full_model test_voltages to fail exact np.testing.assert_equal
    against reference_data. Spikes are unaffected (grid-quantized). This -O3 image reproduces the
    reference bit-for-bit and is intended for the exact-match reference tests / cross-checks; it is
    NOT the production simulation image (it forgoes the native-arch speedup). See
    docs/audits/26-07-11_PYTEST_NEO14_VERIFICATION.md §2.4.
    Build to a NEW sif path (mozaik-opt-refmatch_*.sif); never overwrite mozaik-opt*.sif. mozaik
    itself is NOT installed here (bind-mounted onto PYTHONPATH at runtime).

%environment
    export MOZAIK_HOME=/opt/mozaik
    export PATH="$MOZAIK_HOME/bin:$PATH"
    export PYTHONPATH="$MOZAIK_HOME/lib/python3.10/site-packages:$PYTHONPATH"
    export DEBIAN_FRONTEND=noninteractive
    export NEST_INSTALL_DIR=$MOZAIK_HOME
    # Ensure OpenBLAS uses 1 thread per process (MPI manages the parallelism)
    export OPENBLAS_NUM_THREADS=1

%files
    # Copy the current directory to /app
    . /app

%post
    # Setup environment variables for the build phase
    export MOZAIK_HOME=/opt/mozaik
    export PATH="$MOZAIK_HOME/bin:$PATH"
    export PYTHONPATH="$MOZAIK_HOME/lib/python3.10/site-packages:$PYTHONPATH"
    export DEBIAN_FRONTEND=noninteractive
    export NEST_INSTALL_DIR=$MOZAIK_HOME

    # 1. Install System Dependencies
    # Crucial Change: Added 'libopenblas-dev' explicitly
    apt-get update -y
    apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        git \
        subversion \
        wget \
        python3 \
        python3-dev \
        python3-pip \
        python3-setuptools \
        python3-tk \
        python3-nose \
        python3-venv \
        libopenmpi-dev \
        openmpi-bin \
        libjpeg8-dev \
        libfreetype6-dev \
        zlib1g-dev \
        libpng++-dev \
        libncurses-dev \
        libreadline-dev \
        liblapack-dev \
        libopenblas-dev \
        libgsl-dev \
        libboost-all-dev \
        ffmpeg

    apt-get clean
    rm -rf /var/lib/apt/lists/*

    # 2. Create and activate virtual environment
    python3 -m venv $MOZAIK_HOME
    . $MOZAIK_HOME/bin/activate

    # 3. Install Python dependencies
    #    CHANGE (2026-07): numpy -> "numpy<2" (guard); neo==0.12.0 -> neo==0.14.4
    pip install --upgrade pip
    pip install "numpy<2" scipy mpi4py matplotlib quantities lazyarray interval \
        Pillow param==1.5.1 parameters neo==0.14.4 cython==3.0.10 psutil \
        future requests PyYAML elephant pytest-xdist pytest-timeout junitparser \
        numba numpyencoder sphinx imageio scikit-image som-pbc pandas seaborn \
        jupyterlab tk

    # 4. Install imagen
    #    CHANGE (2026-07): source antolikjan/imagen -> CSNG-MFF/imagen (Jan's updated fork)
    cd /tmp
    git clone https://github.com/CSNG-MFF/imagen.git
    cd imagen
    pip install .
    cd /tmp && rm -rf /tmp/imagen

    # 5. Install PyNN
    #    CHANGE (2026-07): fresh clone already has the rewritten history, but pin it explicitly
    #    with `git reset --hard origin/PyNNStepCurrentModule` (upstream discarded pushed commits).
    cd /tmp
    git clone https://github.com/CSNG-MFF/PyNN.git
    cd PyNN
    git checkout PyNNStepCurrentModule
    git reset --hard origin/PyNNStepCurrentModule
    pip install .
    cd /tmp && rm -rf /tmp/PyNN

    # 6. Install NEST — REFERENCE-MATCHING (-O3 ONLY, matching upstream CSNG-MFF / CI).
    # THE ONE DIFFERENCE vs production: no '-march=native -mtune=native' (avoids FMA/ULP FP drift).
    cd /tmp
    wget https://github.com/nest/nest-simulator/archive/v3.4.tar.gz
    tar xvfz v3.4.tar.gz
    cd nest-simulator-3.4

    cmake \
        -Dwith-mpi=ON \
        -Dwith-boost=ON \
        -DCMAKE_INSTALL_PREFIX:PATH=$MOZAIK_HOME \
        -Dwith-optimize='-O3' \
        -Dwith-gsl=ON \
        -Dwith-python=ON \
        ./

    make -j$(nproc)
    make -j$(nproc) install
    cd /tmp && rm -rf /tmp/nest-simulator-3.4 /tmp/v3.4.tar.gz

    # 7. Install nest-step-current-module — REFERENCE-MATCHING (-O3 ONLY, matching upstream).
    cd /tmp
    git clone https://github.com/CSNG-MFF/nest-step-current-module.git
    cd nest-step-current-module

    cmake \
        -Dwith-mpi=ON \
        -Dwith-boost=ON \
        -Dwith-optimize='-O3' \
        -Dwith-nest=$MOZAIK_HOME/bin/nest-config \
        ./

    make -j$(nproc)
    make -j$(nproc) install
    cd /tmp && rm -rf /tmp/nest-step-current-module

    # 8. Re-pin numpy<2 (GUARD): imagen/PyNN/neo installs above can pull numpy 2.x back in.
    #    Per the discussion: "make sure numpy isn't starting with 2; if it does, pip install numpy<2".
    pip install "numpy<2"
    python -c 'import numpy; assert numpy.__version__[0]=="1", "numpy is 2.x: "+numpy.__version__; print("numpy OK", numpy.__version__)'
    python -c 'import neo; print("neo", neo.__version__)'

    # 8b. Apply neo _contains O(1) perf patch (copied into /app by %files). Fixes the O(N^2)
    #     cross-rank Segment merge (pyNN gather_blocks -> neo.core.container.merge) that ~halved
    #     P1 get_data throughput on neo 0.14. See slurm_neo14_pytest/26-07-13_neo14_slowdown_ROOTCAUSE.md.
    cp /app/objectlist.py     $MOZAIK_HOME/lib/python3.10/site-packages/neo/core/objectlist.py
    cp /app/spiketrainlist.py $MOZAIK_HOME/lib/python3.10/site-packages/neo/core/spiketrainlist.py
    # verify the patch landed (grep the file directly; neo.core shadows the 'objectlist' submodule
    # name with a list attribute, so `import neo.core.objectlist as m` does NOT give the module)
    grep -q "PERF PATCH" $MOZAIK_HOME/lib/python3.10/site-packages/neo/core/objectlist.py \
      && echo "neo _contains O(1) perf patch applied" \
      || { echo "ERROR: neo perf patch NOT applied"; exit 1; }
    python -c 'import neo; print("neo", neo.__version__, "imports OK")'

    # 8c. Apply quantities registry-memo perf patch (copied into /app by %files). Memoizes bare-name
    #     unit-registry lookups: in the neo14 P1 get_data cross-rank merge, Dimensionality.__hash__
    #     re-parsed unit_registry['dimensionless'] (ast.parse+compile+eval) on EVERY hash (~4.55M
    #     calls / ~184s rank-0). Behavior-identical (only identity-stable singletons cached).
    #     Faithful test3 nt12: 913s (neo-patch only) -> 741s (with this) < golden 1015s. 30/30 green.
    #     See mozaik/patches/quantities-0.16.4/README.md.
    cp /app/registry.py $MOZAIK_HOME/lib/python3.10/site-packages/quantities/registry.py
    grep -q "PERF PATCH" $MOZAIK_HOME/lib/python3.10/site-packages/quantities/registry.py \
      && echo "quantities registry-memo perf patch applied" \
      || { echo "ERROR: quantities perf patch NOT applied"; exit 1; }
    python -c 'import quantities; print("quantities", quantities.__version__, "imports OK")'

    # 9. Pre-compile pyNN extensions
    echo "Pre-compiling pyNN extensions..."
    python -c 'import pyNN.nest'

%runscript
    . $MOZAIK_HOME/bin/activate
    python -c 'import nest; nest.Install("stepcurrentmodule")' > /dev/null 2>&1
    exec python "$@"
